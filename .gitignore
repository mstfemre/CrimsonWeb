# ---------------------------------------------------------------------------
# Python bytecode / caches
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.Python
*$py.class

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# ---------------------------------------------------------------------------
# Packaging / build artifacts
# ---------------------------------------------------------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.whl

# ---------------------------------------------------------------------------
# Test / type-check / lint / coverage caches
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# ---------------------------------------------------------------------------
# IDE / editor / environment files
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.env
.direnv/

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# CrimsonWeb runtime outputs, reports, logs, and state
#   NOTE: probes.json is a packaged source file and is intentionally NOT
#   ignored. Only prefixed report artifacts are excluded.
# ---------------------------------------------------------------------------
crimsonweb_audit.log
crimsonweb_audit.log.*
crimsonweb_audit.jsonl
crimsonweb_*.json
crimsonweb_*.csv
crimsonweb_*.md
*.executive.md
*.csv

# Checkpoint / resume state (default: ~/.crimsonweb/state) and any local copy
.crimsonweb/
.install-tmp/
data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite.*.bak
*.sqlite.*.bak-wal
*.sqlite.*.bak-shm
*.discovery.lock
*.privacy.lock
