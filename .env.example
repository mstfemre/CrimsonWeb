# Set these in the process environment; .env is not loaded automatically.
CRIMSON_ALLOWED_HOSTS=localhost,127.0.0.1,::1
CRIMSON_ALLOWED_NETWORKS=127.0.0.0/8,::1/128
# Required: the API refuses to start without it. Use a strong random token.
CRIMSON_API_TOKEN=
# Local development only: allow tokenless loopback clients. Leave unset otherwise.
# CRIMSON_API_DEV_ALLOW_NO_TOKEN=1
# Exact Host header allowlist (no wildcards); add :port to pin a port.
CRIMSON_API_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
CRIMSON_DATABASE_URL=sqlite:///data/crimsonweb.sqlite
# AI is opt-in. Only loopback Ollama origins and local model names are accepted.
CRIMSON_AI_ENABLED=false
CRIMSON_OLLAMA_URL=http://127.0.0.1:11434
CRIMSON_OLLAMA_MODEL=
# default preserves the model's default; gemma4 benchmark profiles may use false.
CRIMSON_OLLAMA_THINK=default
CRIMSON_AI_TIMEOUT=90
CRIMSON_AI_MAX_CONCURRENCY=2
CRIMSON_AI_CALLS_PER_MINUTE=20
CRIMSON_AI_MAX_INPUT_BYTES=32768
CRIMSON_AI_MAX_OUTPUT_TOKENS=4096
CRIMSON_AI_CONTEXT_TOKENS=16384
